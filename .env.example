# ==============================================================================
# AI Database Assistant - Environment Configuration
# ==============================================================================

# Application
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key-32chars
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
FRONTEND_URL=http://localhost:5173/

# Database Configuration (PostgreSQL)
# Format: postgresql://[user[:password]@][host][:port]/[dbname]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidb
# Fallback SQLite DB path used automatically if DATABASE_URL is not set or empty in dev
# DB_FALLBACK_SQLITE=True

# AI / LLM Configuration
# Set OPENAI_API_KEY to activate OpenAI/compatible LLM provider.
# If empty, the system runs automatically in deterministic Demo/Mock mode with zero setup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Query Execution Limits
MAX_ROWS=1000
MAX_QUERY_SECONDS=10
MAX_SQL_LENGTH=10000
MAX_RESULT_SIZE_MB=5

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Demo User Credentials (seeded automatically on startup)
DEMO_USER_EMAIL=demo@aidatabaseassistant.com
DEMO_USER_PASSWORD=DemoPassword123!

# External MySQL 8.4 Integration (Optional - for Docker service and live testing)
# MYSQL_PORT=3306
# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_DATABASE=metriva_mysql_demo
# MYSQL_TEST_HOST=127.0.0.1
# MYSQL_TEST_PORT=3306
# MYSQL_TEST_USER=metriva_readonly
# MYSQL_TEST_PASSWORD=readonly_secure_pass
# MYSQL_TEST_DB=metriva_mysql_demo


